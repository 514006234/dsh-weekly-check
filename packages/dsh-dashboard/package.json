{
  "name": "dsh-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 中央仪表盘：中间整列的卡片网格（周榜 TOP6 / 免费模型 / 最近会话 / 快捷动作 / 支持本项目）+ 侧边栏全局面板图标行",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"]
    }
  },
  "scripts": {
    "gate": "node tools/gate.mjs",
    "render-test": "node tools/render-test.mjs",
    "test": "node tools/gate.mjs && node tools/render-test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
